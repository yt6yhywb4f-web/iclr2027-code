{
  "model": "LLaMA-60M",
  "model_config": "configs/llama_60m.json",
  "dataset": "allenai/c4",
  "dataset_config": "en",
  "tokenizer": "t5-base",
  "data_shuffle_seed": 42,
  "sequence_length": 256,
  "optimizer": "galore_adamw",
  "learning_rate": 0.01,
  "scheduler": "cosine",
  "minimum_lr_ratio": 0.1,
  "warmup_updates": 1000,
  "beta1": 0.9,
  "beta2": 0.999,
  "epsilon": 1e-6,
  "weight_decay": 0.0,
  "gradient_clipping": 0.0,
  "rank": 128,
  "galore_scale": 0.25,
  "projection_type": "std",
  "refresh_interval": 200,
  "microbatch_sequences": 256,
  "gradient_accumulation": 2,
  "effective_batch_sequences": 512,
  "precision": "bfloat16",
  "optimizer_updates": 10000,
  "evaluation_interval": 1000,
  "checkpoint_interval": 10000,
  "dataloader_workers": 8,
  "model_training_seeds": [0, 2, 42],
  "conditions": {
    "carry": "none",
    "reset_m": "reset_m",
    "reset_v": "reset_v",
    "reset_all": "reset_all",
    "local_v_age": "reset_v_local_v_age"
  }
}

